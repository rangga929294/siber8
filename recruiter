<script>
  // Tactical HUD Live Clock Updater
  function updateHUDClock() {
    const clockEl = document.getElementById('hudClock');
    if (!clockEl) return;
    const now = new Date();
    const utcHours = String(now.getUTCHours()).padStart(2, '0');
    const utcMins = String(now.getUTCMinutes()).padStart(2, '0');
    const utcSecs = String(now.getUTCSeconds()).padStart(2, '0');
    const utcMs = String(Math.floor(now.getUTCMilliseconds() / 10)).padStart(2, '0');
    clockEl.innerText = `UTC ${utcHours}:${utcMins}:${utcSecs}.${utcMs}`;
  }
  setInterval(updateHUDClock, 50);
  updateHUDClock();
